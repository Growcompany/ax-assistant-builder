# .env.example → .env 로 복사한 뒤 필요한 값만 채우세요. (.env 는 git에 올라가지 않습니다)
# 비워 두거나 설정하지 않은 항목은 기본값을 씁니다 (src/axbuilder/settings.py).
# 코드는 .env 파일을 직접 읽지 않고 환경변수만 봅니다: 셸에서 export 하거나 실행 도구로 넘기세요.

# 워크스페이스 데이터·색인·API 키 해시 위치 (기본 data → data/workspaces/{id}/).
# axb serve / axb mcp 의 --data-dir 옵션을 주면 그 값이 이것을 대신한다
AXB_DATA_DIR=
# local(Ollama) | cloud(Claude). 기본 local.
# cloud에서는 워크스페이스마다 고른 로컬 모델을 무시하고 AXB_CLAUDE_MODEL만 쓴다(유료 API)
AXB_LLM_MODE=
# 서버 기본 로컬 모델. 워크스페이스에서 모델을 따로 고르지 않았을 때 쓴다. 기본 qwen3.5:4b-q4_K_M
AXB_LOCAL_MODEL=
# 기본 http://localhost:11434. http:// 또는 https://로 시작해야 한다(아니면 서버가 뜨지 않는다).
# 계정 정보(http://user:pass@host)는 Basic 인증으로 보내고 오류 메시지·요청 로그에는 남기지 않는다
AXB_OLLAMA_URL=
# 기본 claude-opus-5-5
AXB_CLAUDE_MODEL=
# 기본 dragonkue/snowflake-arctic-embed-l-v2.0-ko
AXB_EMBED_MODEL=
# API가 받아 주는 Host 머리글의 호스트 이름 (쉼표로 구분, 포트·스킴 없이, IPv6는 [::1]처럼 대괄호).
# 기본 127.0.0.1,localhost,[::1]. 값을 주면 기본 목록을 대신하므로 필요한 이름을 모두 적는다.
# 목록에 없는 Host·Origin의 요청은 403 (DNS 리바인딩 방어). 와일드카드(*)는 없다.
# 이름은 영문·숫자·점·하이픈만 받는다: 끝 점(localhost.)과 밑줄(axb_api)은 설정 오류다.
# 다른 PC에서 API 키로 /v1/* 을 쓰게 하려면(axb serve --host 0.0.0.0) 이 PC의 IP나 이름을 더한다.
# 예: 127.0.0.1,localhost,192.168.0.10  (평문 HTTP다. docs/adr/0005-integration-surface.md 의 운영 경고)
AXB_ALLOWED_HOSTS=
# /v1/* (API 키로 부르는 API) 응답에 CORS 머리글을 달아 줄 출처. 쉼표로 구분, 기본 빈 값(꺼짐).
# 브라우저의 다른 페이지에서 직접 부를 때만 필요하다(서버·스크립트에서 부르면 필요 없다).
# 스킴://호스트[:포트] 그대로 적는다(예: https://portal.example.com,http://localhost:3000).
# 경로·끝 슬래시·와일드카드(*)는 설정 오류다. 관리 API와 화면에는 적용되지 않는다
AXB_CORS_ORIGINS=

# 클라우드 모드에서만 필요. 설정 객체(Settings)에 넣지 않고 SDK가 환경변수에서 직접 읽습니다
ANTHROPIC_API_KEY=
