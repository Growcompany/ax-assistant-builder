# .env.example → .env 로 복사한 뒤 필요한 값만 채우세요. (.env 는 git에 올라가지 않습니다)
# 비워 두거나 설정하지 않은 항목은 기본값을 씁니다 (src/axbuilder/settings.py).
# 코드는 .env 파일을 직접 읽지 않고 환경변수만 봅니다: 셸에서 export 하거나 실행 도구로 넘기세요.

# 워크스페이스 데이터·색인 위치 (기본 data → data/workspaces/{id}/)
AXB_DATA_DIR=
# local(Ollama) | cloud(Claude). 기본 local
AXB_LLM_MODE=
# 기본 qwen3.5:4b-q4_K_M
AXB_LOCAL_MODEL=
# 기본 http://localhost:11434
AXB_OLLAMA_URL=
# 기본 claude-opus-5-5
AXB_CLAUDE_MODEL=
# 기본 dragonkue/snowflake-arctic-embed-l-v2.0-ko
AXB_EMBED_MODEL=

# 클라우드 모드에서만 필요. 설정 객체(Settings)에 넣지 않고 SDK가 환경변수에서 직접 읽습니다
ANTHROPIC_API_KEY=
