# .env.example → .env 로 복사한 뒤 필요한 값만 채우세요. (.env 는 git에 올라가지 않습니다)
# 비워 두거나 설정하지 않은 항목은 기본값을 씁니다 (src/axbuilder/settings.py).
# 코드는 .env 파일을 직접 읽지 않고 환경변수만 봅니다: 셸에서 export 하거나 실행 도구로 넘기세요.

# 워크스페이스 데이터·색인·API 키 해시 위치 (기본 data → data/workspaces/{id}/).
# axb serve / axb mcp 의 --data-dir 옵션을 주면 그 값이 이것을 대신한다
AXB_DATA_DIR=
# local(Ollama) | cloud(Claude). 기본 local.
# cloud에서는 워크스페이스마다 고른 로컬 모델을 무시하고 AXB_CLAUDE_MODEL만 쓴다(유료 API)
AXB_LLM_MODE=
# 서버 기본 로컬 모델. 워크스페이스에서 모델을 따로 고르지 않았을 때 쓴다. 기본 qwen3.5:4b-q4_K_M
AXB_LOCAL_MODEL=
# 기본 http://localhost:11434. http:// 또는 https://로 시작해야 한다(아니면 서버가 뜨지 않는다).
# 계정 정보(http://user:pass@host)는 Basic 인증으로 보내고 오류 메시지·요청 로그에는 남기지 않는다
AXB_OLLAMA_URL=
# 기본 claude-opus-5-5
AXB_CLAUDE_MODEL=
# 기본 dragonkue/snowflake-arctic-embed-l-v2.0-ko
AXB_EMBED_MODEL=
# API가 받아 주는 Host 머리글의 호스트 이름 (쉼표로 구분, 포트·스킴 없이, IPv6는 [::1]처럼 대괄호).
# 기본 127.0.0.1,localhost,[::1]. 값을 주면 기본 목록을 대신하므로 필요한 이름을 모두 적는다.
# 목록에 없는 Host·Origin의 요청은 403 (DNS 리바인딩 방어). 와일드카드(*)는 없다.
# 이름은 영문·숫자·점·하이픈만 받는다: 끝 점(localhost.)과 밑줄(axb_api)은 설정 오류다.
# 다른 PC에서 API 키로 /v1/* 을 쓰게 하려면(axb serve --host 0.0.0.0) 이 PC의 IP나 이름을 더한다.
# 예: 127.0.0.1,localhost,192.168.0.10  (평문 HTTP다. docs/adr/0005-integration-surface.md 의 운영 경고)
AXB_ALLOWED_HOSTS=
# /v1/* (API 키로 부르는 API) 응답에 CORS 머리글을 달아 줄 출처. 쉼표로 구분, 기본 빈 값(꺼짐).
# 브라우저의 다른 페이지에서 직접 부를 때만 필요하다(서버·스크립트에서 부르면 필요 없다).
# 스킴://호스트[:포트] 그대로 적는다(예: https://portal.example.com,http://localhost:3000).
# 경로·끝 슬래시·와일드카드(*)는 설정 오류다. 관리 API와 화면에는 적용되지 않는다
AXB_CORS_ORIGINS=
# API 문서 화면(/docs, /redoc)을 켠다(true/false). 기본 false.
# 켜면 그 화면이 외부 CDN의 스크립트를 불러오고, 화면 안의 버튼으로 관리 API가 실행된다.
# 개발할 때만 켠다. /openapi.json은 꺼져 있어도 있다
AXB_API_DOCS=
# 리랭커: 검색 결과 후보를 크로스 인코더로 다시 줄 세운 뒤 답한다. none | kure-nano | bge-v2-m3, 기본 none(꺼짐).
#   kure-nano = nlpai-lab/KURE-Reranker-nano   약 0.6GB, 질문당 약 0.4초 추가(검색만 잴 때. LLM과 한 GPU를 쓰면 더 든다)
#   bge-v2-m3 = BAAI/bge-reranker-v2-m3        약 2.3GB, 질문당 약 0.8초 추가
#   (시간은 확인한 PC에서 후보 30개 기준. GPU가 없으면 더 느리다)
# 모델은 서버를 띄울 때가 아니라 처음 질문할 때 내려받아 올린다. ml 의존성이 필요하다: pip install -e ".[ml]"
# 불러오지 못하면 질문은 503이다(리랭커 없이 조용히 답하지 않는다). 그 밖의 값은 설정 오류다.
# 색인과는 무관하다: 켜거나 꺼도 다시 색인하지 않는다. 화면·/ask·/v1/*·axb mcp 에 모두 적용된다
AXB_RERANKER=
# 리랭커에 넘기는 후보 수 (1~200, 기본 30). 리랭커가 꺼져 있으면 쓰지 않는다.
# 늘리면 정답이 후보에 들 가능성은 커지지만 질문당 시간이 후보 수만큼 늘어난다
AXB_RERANK_CANDIDATES=
# 긴 조항 나누기: 본문 조항(제N조)이 이 글자 수보다 길면 항(①②…) → 호(1. 2.) → 목(가. 나.) → 줄
# 경계에서 나누고, 이웃 조각을 이 글자 수 안에서 묶는다. 둘째 조각부터 조항 머리("제11조(대리인 거래)")를
# 붙이고 조항 번호(인용 표시)는 그대로다. 비워 두면 나누지 않는다(기본). 200~20000, 그 밖의 값은 설정 오류.
#   800 = 측정한 값: 나눈 조각의 98% 이상이 질문과 합쳐 리랭커 입력 512토큰 안에 든다
#         (docs/learning/task-25-article-split.md). 기본값은 실험 뒤에 정한다(ADR 0007)
# 부칙·상품설명서(고정 800자)·첫 조항 앞 머리말은 나누지 않는다.
# 값을 바꾸면 기존 색인은 "다시 색인 필요"(stale)로 보이고, 다시 색인할 때까지 질문은 409다
# (다른 분할로 만든 청크로 답하지 않는다). 화면·/ask·/v1/*·axb mcp 에 모두 적용된다
AXB_MAX_CHUNK_CHARS=

# 클라우드 모드에서만 필요. 설정 객체(Settings)에 넣지 않고 SDK가 환경변수에서 직접 읽습니다
ANTHROPIC_API_KEY=
