# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---- RAG data / artifacts (원본 문서·인덱스는 커밋하지 않음) ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# AXB_DATA_DIR 기본값 "data"는 실행 위치 기준이라, 하위 폴더에서 실행해도 원문이 올라가지 않게
**/data/workspaces/
*.hwpx
vectorstore/
chroma_db/
*.faiss
*.index

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings (per-machine)
.claude/settings.local.json
.claude/worktrees/

# ---- 평가 결과 (Task 9 CLI가 reports/{workspace}/에 쓴다) ----
reports/
